# Dynamic Forecasting Configuration Example
# Copy this file to .env and customize as needed

# Timezone for forecast output
FORECAST_TIMEZONE=America/New_York

# Default forecast hours
DEFAULT_FORECAST_HOURS=48

# Herbie settings
HERBIE_MODEL=hrrr
HERBIE_PRODUCT=sfc
HERBIE_CACHE_DIR=./cache/herbie

# Open-Meteo settings
OPENMETEO_CACHE_EXPIRE_HOURS=1
OPENMETEO_USE_GFS=false

# Logging
LOG_LEVEL=INFO
